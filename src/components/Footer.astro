---
// Footer.astro - Multi-Page Footer with Legal Links
---

<footer class="w-full bg-[var(--color-canvas)] border-t border-[var(--color-hairline)] py-12 md:py-16 px-4 md:px-8 text-xs text-[var(--color-body)] transition-colors">
  <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
    
    <!-- Col 1: Brand & Domain -->
    <div class="space-y-3">
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded bg-[var(--color-primary)] text-[var(--color-on-primary)] flex items-center justify-center font-bold text-xs">
          M
        </div>
        <span class="font-semibold text-sm text-[var(--color-ink)]">Meta Data Remover</span>
      </div>
      <p class="text-[var(--color-mute)] leading-relaxed text-[11px]">
        100% Private, browser-based metadata stripper & EXIF inspector. Erase GPS, camera tags, and AI prompts without server uploads.
      </p>
      <p class="font-mono text-[11px] text-[#0070f3]">
        metadataremover.tech
      </p>
    </div>

    <!-- Col 2: Navigation -->
    <div class="space-y-2">
      <h4 class="caption-mono text-[var(--color-ink)] font-semibold mb-3">Navigation</h4>
      <ul class="space-y-2">
        <li><a href="/" class="hover:text-[var(--color-ink)] transition-colors">Metadata Tool</a></li>
        <li><a href="/features" class="hover:text-[var(--color-ink)] transition-colors">Supported Fields</a></li>
        <li><a href="/how-it-works" class="hover:text-[var(--color-ink)] transition-colors">How It Works</a></li>
        <li><a href="/comparison" class="hover:text-[var(--color-ink)] transition-colors">Competitor Benchmark</a></li>
        <li><a href="/faq" class="hover:text-[var(--color-ink)] transition-colors">FAQ Hub</a></li>
      </ul>
    </div>

    <!-- Col 3: Legal & Support -->
    <div class="space-y-2">
      <h4 class="caption-mono text-[var(--color-ink)] font-semibold mb-3">Legal & Support</h4>
      <ul class="space-y-2">
        <li><a href="/privacy" class="hover:text-[var(--color-ink)] transition-colors">Privacy Policy</a></li>
        <li><a href="/terms" class="hover:text-[var(--color-ink)] transition-colors">Terms of Service</a></li>
        <li><a href="/contact" class="hover:text-[var(--color-ink)] transition-colors">Contact & Feedback</a></li>
      </ul>
    </div>

    <!-- Col 4: Privacy Sandbox Notice -->
    <div class="space-y-2">
      <h4 class="caption-mono text-[var(--color-ink)] font-semibold mb-3">Privacy Guarantee</h4>
      <div class="p-3 rounded-lg bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] text-[11px] space-y-1.5">
        <div class="flex items-center gap-1.5 font-semibold text-[var(--color-ink)]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#50e3c2]"></span>
          <span>Zero Server Uploads</span>
        </div>
        <p class="text-[var(--color-mute)]">
          Files are processed in local memory only. Disconnect Wi-Fi at any time to verify offline execution.
        </p>
      </div>
    </div>

  </div>

  <!-- Bottom Bar -->
  <div class="max-w-5xl mx-auto pt-6 border-t border-[var(--color-hairline)] flex flex-col sm:flex-row items-center justify-between gap-4 text-[var(--color-mute)] text-[11px]">
    <div>
      © {new Date().getFullYear()} Meta Data Remover (<a href="https://metadataremover.tech" class="hover:text-[var(--color-ink)] underline">metadataremover.tech</a>). All rights reserved.
    </div>

    <div class="flex items-center gap-4">
      <a href="/privacy" class="hover:text-[var(--color-ink)] transition-colors">Privacy Policy</a>
      <span>•</span>
      <a href="/terms" class="hover:text-[var(--color-ink)] transition-colors">Terms of Service</a>
      <span>•</span>
      <a href="/contact" class="hover:text-[var(--color-ink)] transition-colors">Contact Us</a>
    </div>
  </div>
</footer>
