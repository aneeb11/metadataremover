---
// MetadataApp.astro - Main Browser-Based EXIF & Metadata Stripper Application
---

<section id="app" class="relative w-full py-12 md:py-20 px-4 md:px-8 mesh-gradient-bg">
  <div class="max-w-5xl mx-auto flex flex-col items-center text-center">
    
    <!-- Hero Announcement Pill -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--color-canvas)]/80 backdrop-blur-md border border-[var(--color-hairline)] text-xs font-mono text-[var(--color-ink)] mb-6 shadow-xs">
      <span class="w-2 h-2 rounded-full bg-[#0070f3]"></span>
      <span class="text-[var(--color-body)]">100% Client-Side Privacy Sandbox</span>
      <span class="text-[var(--color-hairline-strong)]">•</span>
      <span class="text-[#0070f3] font-semibold">Zero Uploads</span>
    </div>

    <!-- Main Headline -->
    <h1 class="display-xl text-[var(--color-ink)] max-w-3xl mb-4 tracking-tight">
      Remove Hidden Image Metadata Instantly.
    </h1>

    <!-- Subtitle -->
    <p class="text-base md:text-lg text-[var(--color-body)] max-w-2xl mb-10 leading-relaxed">
      Strip camera EXIF data, GPS location geotags, C2PA credentials, and AI prompts (DALL-E, Midjourney, Stable Diffusion) from your images right inside your browser.
    </p>

    <!-- App Container Card -->
    <div class="w-full bg-[var(--color-canvas)] border border-[var(--color-hairline)] rounded-xl shadow-stacked p-6 md:p-8 text-left transition-colors">
      
      <!-- Controls Top Header -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-[var(--color-hairline)]">
        <div class="flex items-center gap-3">
          <div class="w-3 h-3 rounded-full bg-[#50e3c2] animate-pulse"></div>
          <div>
            <h2 class="text-sm font-semibold text-[var(--color-ink)]">Browser Privacy Sandbox</h2>
            <p class="text-xs text-[var(--color-mute)] font-mono">Files never leave your local device</p>
          </div>
        </div>

        <!-- Mode Selector -->
        <div class="flex items-center gap-2 bg-[var(--color-canvas-soft-2)] p-1 rounded-lg border border-[var(--color-hairline)] text-xs font-medium">
          <label class="flex items-center gap-1.5 px-2.5 py-1 rounded-md cursor-pointer transition-colors bg-[var(--color-canvas)] text-[var(--color-ink)] shadow-xs" id="mode-lossless-label">
            <input type="radio" name="strip-mode" value="lossless" checked class="hidden" id="mode-lossless" />
            <svg class="w-3.5 h-3.5 text-[#0070f3]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Lossless EXIF Strip</span>
          </label>

          <label class="flex items-center gap-1.5 px-2.5 py-1 rounded-md cursor-pointer transition-colors text-[var(--color-body)] hover:text-[var(--color-ink)]" id="mode-noise-label">
            <input type="radio" name="strip-mode" value="hash-reset" class="hidden" id="mode-hash-reset" />
            <svg class="w-3.5 h-3.5 text-[#7928ca]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            <span>Privacy Turbo (Hash Reset)</span>
          </label>
        </div>
      </div>

      <!-- Dropzone Area -->
      <div 
        id="dropzone"
        class="mt-6 border-2 border-dashed border-[var(--color-hairline)] hover:border-[var(--color-ink)] bg-[var(--color-canvas-soft)] hover:bg-[var(--color-canvas)] rounded-xl p-8 md:p-12 flex flex-col items-center justify-center text-center cursor-pointer transition-all group"
      >
        <input type="file" id="file-input" multiple accept="image/jpeg,image/png,image/webp,image/avif,image/gif" class="hidden" />

        <div class="w-14 h-14 rounded-full bg-[var(--color-canvas)] border border-[var(--color-hairline)] flex items-center justify-center mb-4 group-hover:scale-110 group-hover:border-[var(--color-ink)] transition-all shadow-xs">
          <svg class="w-7 h-7 text-[var(--color-ink)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
        </div>

        <h3 class="text-base font-semibold text-[var(--color-ink)] mb-1">
          Drag & drop images here, or <span class="text-[#0070f3] underline underline-offset-2">browse files</span>
        </h3>
        <p class="text-xs text-[var(--color-mute)] font-mono mb-4">
          Supports JPEG, PNG, WebP, AVIF, GIF • Batch processing supported
        </p>

        <!-- Format Pills -->
        <div class="flex flex-wrap justify-center gap-1.5">
          <span class="caption-mono bg-[var(--color-canvas)] border border-[var(--color-hairline)] px-2 py-0.5 rounded text-[var(--color-body)]">.JPG</span>
          <span class="caption-mono bg-[var(--color-canvas)] border border-[var(--color-hairline)] px-2 py-0.5 rounded text-[var(--color-body)]">.PNG</span>
          <span class="caption-mono bg-[var(--color-canvas)] border border-[var(--color-hairline)] px-2 py-0.5 rounded text-[var(--color-body)]">.WEBP</span>
          <span class="caption-mono bg-[var(--color-canvas)] border border-[var(--color-hairline)] px-2 py-0.5 rounded text-[var(--color-body)]">.AVIF</span>
          <span class="caption-mono bg-[var(--color-canvas)] border border-[var(--color-hairline)] px-2 py-0.5 rounded text-[var(--color-body)]">.GIF</span>
        </div>
      </div>

      <!-- File Queue Manager -->
      <div id="file-queue-container" class="mt-8 hidden">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <h3 class="text-sm font-semibold text-[var(--color-ink)]">Uploaded Files</h3>
            <span id="file-count-badge" class="caption-mono bg-[var(--color-primary)] text-[var(--color-on-primary)] px-2 py-0.5 rounded-full text-[10px]">0</span>
          </div>

          <div class="flex items-center gap-2">
            <button id="btn-clear-all" class="text-xs text-[var(--color-mute)] hover:text-[#ee0000] font-medium px-2 py-1 transition-colors">
              Clear All
            </button>
          </div>
        </div>

        <!-- File Cards List -->
        <div id="file-list" class="space-y-3 max-h-[450px] overflow-y-auto pr-1">
          <!-- Dynamically inserted file rows -->
        </div>

        <!-- Action Bar -->
        <div class="mt-6 pt-4 border-t border-[var(--color-hairline)] flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="text-xs text-[var(--color-mute)] font-mono" id="queue-status-summary">
            Ready to strip metadata.
          </div>

          <div class="flex items-center gap-3 w-full sm:w-auto">
            <button id="btn-strip-all" class="flex-1 sm:flex-initial px-6 py-2.5 rounded-full bg-[var(--color-primary)] hover:opacity-90 text-[var(--color-on-primary)] text-sm font-medium transition-all shadow-xs hover:scale-[1.02] flex items-center justify-center gap-2">
              <svg class="w-4 h-4 text-[#50e3c2]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              <span>Strip All Metadata</span>
            </button>

            <button id="btn-download-zip" disabled class="px-5 py-2.5 rounded-full bg-[var(--color-canvas-soft-2)] text-[var(--color-mute)] border border-[var(--color-hairline)] text-sm font-medium transition-all flex items-center justify-center gap-2 cursor-not-allowed">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
              <span>Download ZIP</span>
            </button>
          </div>
        </div>
      </div>

    </div>

    <!-- Security & Privacy Trust Badges -->
    <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4 w-full max-w-4xl text-center">
      <div class="p-4 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-xs flex flex-col items-center">
        <div class="w-8 h-8 rounded-full bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] flex items-center justify-center mb-2 text-[#0070f3]">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        </div>
        <h4 class="text-xs font-semibold text-[var(--color-ink)]">100% In-Browser</h4>
        <p class="text-[11px] text-[var(--color-mute)]">Zero network uploads or server storage</p>
      </div>

      <div class="p-4 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-xs flex flex-col items-center">
        <div class="w-8 h-8 rounded-full bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] flex items-center justify-center mb-2 text-[#7928ca]">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
        </div>
        <h4 class="text-xs font-semibold text-[var(--color-ink)]">GPS & AI Stripper</h4>
        <p class="text-[11px] text-[var(--color-mute)]">Cleans geotags, camera EXIF, & prompts</p>
      </div>

      <div class="p-4 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-xs flex flex-col items-center">
        <div class="w-8 h-8 rounded-full bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] flex items-center justify-center mb-2 text-[#50e3c2]">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        </div>
        <h4 class="text-xs font-semibold text-[var(--color-ink)]">Instant ZIP Export</h4>
        <p class="text-[11px] text-[var(--color-mute)]">Download individual files or bulk ZIP</p>
      </div>
    </div>

  </div>

  <!-- Tag Inspector Modal -->
  <div id="inspector-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 hidden">
    <div class="bg-[var(--color-canvas)] border border-[var(--color-hairline)] rounded-xl shadow-2xl w-full max-w-2xl max-h-[85vh] flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200">
      
      <!-- Modal Header -->
      <div class="px-6 py-4 border-b border-[var(--color-hairline)] flex items-center justify-between bg-[var(--color-canvas-soft-2)]">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-[#0070f3]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <div>
            <h3 class="text-sm font-semibold text-[var(--color-ink)]" id="modal-filename">Metadata Tag Inspector</h3>
            <p class="text-[11px] text-[var(--color-mute)] font-mono" id="modal-tag-count">0 metadata tags identified</p>
          </div>
        </div>

        <button id="modal-close-btn" class="w-8 h-8 rounded-full hover:bg-[var(--color-hairline)] flex items-center justify-center text-[var(--color-mute)] hover:text-[var(--color-ink)] transition-colors">
          ✕
        </button>
      </div>

      <!-- Modal Search Bar -->
      <div class="px-6 py-3 border-b border-[var(--color-hairline)] bg-[var(--color-canvas)]">
        <div class="relative">
          <input 
            type="text" 
            id="modal-search-input" 
            placeholder="Search tags (e.g. GPS, Make, Date, Prompt, ISO)..." 
            class="w-full bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] rounded-lg px-3 py-1.5 pl-9 text-xs text-[var(--color-ink)] focus:outline-none focus:border-[var(--color-ink)]"
          />
          <svg class="w-4 h-4 text-[var(--color-mute)] absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>
      </div>

      <!-- Modal Table Body -->
      <div class="p-6 overflow-y-auto flex-1 bg-[var(--color-canvas)]">
        <div id="modal-gps-callout" class="hidden mb-4 p-3 rounded-lg bg-[#ffefcf] dark:bg-[#ab570a]/20 border border-[#f5a623] text-xs text-[#ab570a] dark:text-[#ffefcf] flex items-center justify-between">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#ab570a] dark:text-[#ffefcf]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span class="font-medium" id="gps-coords-text">Exact GPS Location Embedded</span>
          </div>
          <a id="gps-map-link" href="#" target="_blank" rel="noopener noreferrer" class="underline font-semibold hover:text-[var(--color-ink)]">View Map</a>
        </div>

        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b border-[var(--color-hairline)] text-[var(--color-mute)] font-mono caption-mono">
              <th class="py-2 px-3">Tag / Property</th>
              <th class="py-2 px-3">Embedded Value</th>
            </tr>
          </thead>
          <tbody id="modal-tags-tbody">
            <!-- Dynamic tag rows -->
          </tbody>
        </table>

        <div id="modal-empty-state" class="hidden text-center py-8 text-xs text-[var(--color-mute)]">
          No matching metadata tags found.
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="px-6 py-3 border-t border-[var(--color-hairline)] bg-[var(--color-canvas-soft-2)] flex justify-end">
        <button id="modal-dismiss-btn" class="px-4 py-1.5 rounded-full bg-[var(--color-primary)] text-[var(--color-on-primary)] text-xs font-medium hover:opacity-90 transition-colors">
          Close Inspector
        </button>
      </div>

    </div>
  </div>

</section>

<!-- Client Side Scripting Engine -->
<script>
  import exifr from 'exifr';
  import JSZip from 'jszip';

  // Application State
  interface ProcessedFile {
    id: string;
    file: File;
    name: string;
    size: number;
    type: string;
    previewUrl: string;
    rawTags: Record<string, any>;
    rawTagCount: number;
    strippedBlob: Blob | null;
    strippedUrl: string | null;
    status: 'reading' | 'ready' | 'stripped' | 'error';
  }

  let filesQueue: ProcessedFile[] = [];
  let currentStripMode: 'lossless' | 'hash-reset' = 'lossless';
  let activeModalFileId: string | null = null;

  // DOM Elements
  const dropzone = document.getElementById('dropzone') as HTMLElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const fileQueueContainer = document.getElementById('file-queue-container') as HTMLElement;
  const fileList = document.getElementById('file-list') as HTMLElement;
  const fileCountBadge = document.getElementById('file-count-badge') as HTMLElement;
  const btnClearAll = document.getElementById('btn-clear-all') as HTMLButtonElement;
  const btnStripAll = document.getElementById('btn-strip-all') as HTMLButtonElement;
  const btnDownloadZip = document.getElementById('btn-download-zip') as HTMLButtonElement;
  const queueStatusSummary = document.getElementById('queue-status-summary') as HTMLElement;

  // Radio Mode Switches
  const radioLossless = document.getElementById('mode-lossless') as HTMLInputElement;
  const radioHashReset = document.getElementById('mode-hash-reset') as HTMLInputElement;
  const labelLossless = document.getElementById('mode-lossless-label') as HTMLElement;
  const labelHashReset = document.getElementById('mode-noise-label') as HTMLElement;

  // Modal Elements
  const inspectorModal = document.getElementById('inspector-modal') as HTMLElement;
  const modalCloseBtn = document.getElementById('modal-close-btn') as HTMLButtonElement;
  const modalDismissBtn = document.getElementById('modal-dismiss-btn') as HTMLButtonElement;
  const modalFilename = document.getElementById('modal-filename') as HTMLElement;
  const modalTagCount = document.getElementById('modal-tag-count') as HTMLElement;
  const modalSearchInput = document.getElementById('modal-search-input') as HTMLInputElement;
  const modalTagsTbody = document.getElementById('modal-tags-tbody') as HTMLElement;
  const modalEmptyState = document.getElementById('modal-empty-state') as HTMLElement;
  const modalGpsCallout = document.getElementById('modal-gps-callout') as HTMLElement;
  const gpsCoordsText = document.getElementById('gps-coords-text') as HTMLElement;
  const gpsMapLink = document.getElementById('gps-map-link') as HTMLAnchorElement;

  // Mode Selection Handler
  function setStripMode(mode: 'lossless' | 'hash-reset') {
    currentStripMode = mode;
    if (mode === 'lossless') {
      labelLossless.className = 'flex items-center gap-1.5 px-2.5 py-1 rounded-md cursor-pointer transition-colors bg-[var(--color-canvas)] text-[var(--color-ink)] shadow-xs';
      labelHashReset.className = 'flex items-center gap-1.5 px-2.5 py-1 rounded-md cursor-pointer transition-colors text-[var(--color-body)] hover:text-[var(--color-ink)]';
    } else {
      labelHashReset.className = 'flex items-center gap-1.5 px-2.5 py-1 rounded-md cursor-pointer transition-colors bg-[var(--color-canvas)] text-[var(--color-ink)] shadow-xs';
      labelLossless.className = 'flex items-center gap-1.5 px-2.5 py-1 rounded-md cursor-pointer transition-colors text-[var(--color-body)] hover:text-[var(--color-ink)]';
    }
  }

  radioLossless?.addEventListener('change', () => setStripMode('lossless'));
  radioHashReset?.addEventListener('change', () => setStripMode('hash-reset'));

  // Dropzone Events
  dropzone?.addEventListener('click', () => fileInput.click());

  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('border-[var(--color-ink)]', 'bg-[var(--color-canvas)]');
  });

  dropzone?.addEventListener('dragleave', () => {
    dropzone.classList.remove('border-[var(--color-ink)]', 'bg-[var(--color-canvas)]');
  });

  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-[var(--color-ink)]', 'bg-[var(--color-canvas)]');
    if (e.dataTransfer?.files) {
      handleFiles(Array.from(e.dataTransfer.files));
    }
  });

  fileInput?.addEventListener('change', (e) => {
    if (fileInput.files) {
      handleFiles(Array.from(fileInput.files));
      fileInput.value = '';
    }
  });

  // Handle Input Files
  async function handleFiles(newFiles: File[]) {
    const validFiles = newFiles.filter(f => f.type.startsWith('image/'));
    if (validFiles.length === 0) return;

    fileQueueContainer.classList.remove('hidden');

    for (const file of validFiles) {
      const fileId = Math.random().toString(36).substring(2, 11);
      const previewUrl = URL.createObjectURL(file);

      const fileItem: ProcessedFile = {
        id: fileId,
        file,
        name: file.name,
        size: file.size,
        type: file.type,
        previewUrl,
        rawTags: {},
        rawTagCount: 0,
        strippedBlob: null,
        strippedUrl: null,
        status: 'reading'
      };

      filesQueue.push(fileItem);
      renderFileItem(fileItem);
      updateQueueSummary();

      // Read EXIF tags asynchronously
      readMetadata(fileItem);
    }
  }

  // Parse Metadata with exifr
  async function readMetadata(item: ProcessedFile) {
    try {
      const parsed = await exifr.parse(item.file, {
        tiff: true,
        xmp: true,
        icc: true,
        iptc: true,
        jfif: true,
        ihdr: true
      }) || {};

      item.rawTags = parsed;
      item.rawTagCount = Object.keys(parsed).length;
      item.status = 'ready';
    } catch (err) {
      console.warn('Metadata parse warning:', err);
      item.rawTags = {};
      item.rawTagCount = 0;
      item.status = 'ready';
    }

    updateFileItemDOM(item);
    updateQueueSummary();
  }

  // Helper: Format file sizes
  function formatBytes(bytes: number): string {
    if (bytes === 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
  }

  // Render File Row in UI
  function renderFileItem(item: ProcessedFile) {
    const row = document.createElement('div');
    row.id = `file-row-${item.id}`;
    row.className = 'p-3 bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] rounded-lg flex items-center justify-between gap-3 hover:border-[var(--color-hairline-strong)] transition-all';
    
    row.innerHTML = `
      <div class="flex items-center gap-3 overflow-hidden">
        <img src="${item.previewUrl}" alt="${item.name}" class="w-12 h-12 object-cover rounded border border-[var(--color-hairline)] flex-shrink-0 bg-[var(--color-canvas)]" />
        <div class="min-w-0">
          <h4 class="text-xs font-semibold text-[var(--color-ink)] truncate">${item.name}</h4>
          <div class="flex items-center gap-2 mt-0.5">
            <span class="text-[11px] text-[var(--color-mute)] font-mono">${formatBytes(item.size)}</span>
            <span class="text-[var(--color-hairline-strong)]">•</span>
            <span class="tag-badge text-[10px] caption-mono bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-[var(--color-body)] px-1.5 py-0.5 rounded">
              Reading...
            </span>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-2 flex-shrink-0">
        <button class="btn-inspect px-2.5 py-1 text-xs font-medium text-[var(--color-body)] hover:text-[var(--color-ink)] bg-[var(--color-canvas)] border border-[var(--color-hairline)] hover:border-[var(--color-ink)] rounded-md transition-colors">
          Inspect Tags
        </button>

        <button class="btn-strip-single px-3 py-1 text-xs font-medium text-[var(--color-on-primary)] bg-[var(--color-primary)] hover:opacity-90 rounded-md transition-colors flex items-center gap-1">
          Strip
        </button>

        <a class="btn-download-single hidden px-3 py-1 text-xs font-semibold text-white bg-[#0070f3] hover:bg-[#0761d1] rounded-md transition-colors flex items-center gap-1 shadow-xs">
          ⬇ Download Clean
        </a>

        <button class="btn-remove-single p-1 text-[var(--color-mute)] hover:text-[#ee0000] rounded transition-colors">
          ✕
        </button>
      </div>
    `;

    // Attach row events
    row.querySelector('.btn-inspect')?.addEventListener('click', () => openInspectorModal(item.id));
    row.querySelector('.btn-strip-single')?.addEventListener('click', () => stripSingleFile(item.id));
    row.querySelector('.btn-remove-single')?.addEventListener('click', () => removeSingleFile(item.id));

    fileList.appendChild(row);
  }

  // Update File Row DOM
  function updateFileItemDOM(item: ProcessedFile) {
    const row = document.getElementById(`file-row-${item.id}`);
    if (!row) return;

    const tagBadge = row.querySelector('.tag-badge') as HTMLElement;
    const btnStrip = row.querySelector('.btn-strip-single') as HTMLElement;
    const btnDownload = row.querySelector('.btn-download-single') as HTMLAnchorElement;

    if (item.status === 'ready') {
      tagBadge.textContent = `${item.rawTagCount} Tags Found`;
      tagBadge.className = item.rawTagCount > 0 
        ? 'tag-badge text-[10px] caption-mono bg-[#ffefcf] dark:bg-[#ab570a]/20 border border-[#f5a623] text-[#ab570a] dark:text-[#ffefcf] px-1.5 py-0.5 rounded font-semibold'
        : 'tag-badge text-[10px] caption-mono bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-[var(--color-mute)] px-1.5 py-0.5 rounded';
    } else if (item.status === 'stripped') {
      tagBadge.textContent = '0 Tags (Cleaned)';
      tagBadge.className = 'tag-badge text-[10px] caption-mono bg-[#aaffec] dark:bg-[#29bc9b]/20 border border-[#29bc9b] text-[#29bc9b] dark:text-[#aaffec] px-1.5 py-0.5 rounded font-semibold';
      
      btnStrip.classList.add('hidden');
      if (item.strippedUrl) {
        btnDownload.classList.remove('hidden');
        btnDownload.href = item.strippedUrl;
        btnDownload.download = `clean_${item.name}`;
      }
    }
  }

  // Strip Metadata (Canvas Re-rendering)
  async function stripFileBlob(item: ProcessedFile, mode: 'lossless' | 'hash-reset'): Promise<Blob> {
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.crossOrigin = 'anonymous';

      img.onload = () => {
        const canvas = document.createElement('canvas');
        canvas.width = img.naturalWidth || img.width;
        canvas.height = img.naturalHeight || img.height;

        const ctx = canvas.getContext('2d');
        if (!ctx) {
          reject(new Error('Canvas context failure'));
          return;
        }

        ctx.drawImage(img, 0, 0);

        // Optional Perceptual Hash Reset Noise Injection
        if (mode === 'hash-reset') {
          const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
          const data = imgData.data;
          for (let i = 0; i < Math.min(100, data.length); i += 4) {
            data[i] = data[i] ^ 1;
          }
          ctx.putImageData(imgData, 0, 0);
        }

        const outputMime = item.type === 'image/png' ? 'image/png' : 'image/jpeg';
        canvas.toBlob((blob) => {
          if (blob) {
            resolve(blob);
          } else {
            reject(new Error('Blob conversion error'));
          }
        }, outputMime, 0.95);
      };

      img.onerror = (e) => reject(e);
      img.src = item.previewUrl;
    });
  }

  // Single File Strip Action
  async function stripSingleFile(id: string) {
    const item = filesQueue.find(f => f.id === id);
    if (!item) return;

    try {
      const cleanBlob = await stripFileBlob(item, currentStripMode);
      item.strippedBlob = cleanBlob;
      item.strippedUrl = URL.createObjectURL(cleanBlob);
      item.status = 'stripped';

      updateFileItemDOM(item);
      updateQueueSummary();
    } catch (err) {
      console.error('Strip error:', err);
    }
  }

  // Remove File from Queue
  function removeSingleFile(id: string) {
    const itemIndex = filesQueue.findIndex(f => f.id === id);
    if (itemIndex > -1) {
      const item = filesQueue[itemIndex];
      URL.revokeObjectURL(item.previewUrl);
      if (item.strippedUrl) URL.revokeObjectURL(item.strippedUrl);
      
      filesQueue.splice(itemIndex, 1);
      document.getElementById(`file-row-${id}`)?.remove();
      updateQueueSummary();

      if (filesQueue.length === 0) {
        fileQueueContainer.classList.add('hidden');
      }
    }
  }

  // Clear All Queue
  btnClearAll?.addEventListener('click', () => {
    filesQueue.forEach(item => {
      URL.revokeObjectURL(item.previewUrl);
      if (item.strippedUrl) URL.revokeObjectURL(item.strippedUrl);
    });
    filesQueue = [];
    fileList.innerHTML = '';
    fileQueueContainer.classList.add('hidden');
    updateQueueSummary();
  });

  // Strip All Files Action
  btnStripAll?.addEventListener('click', async () => {
    btnStripAll.disabled = true;
    btnStripAll.innerHTML = `<span class="animate-spin text-white">🌀</span> Processing...`;

    for (const item of filesQueue) {
      if (item.status !== 'stripped') {
        await stripSingleFile(item.id);
      }
    }

    btnStripAll.disabled = false;
    btnStripAll.innerHTML = `<svg class="w-4 h-4 text-[#50e3c2]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg><span>Strip All Metadata</span>`;
  });

  // Download All as ZIP Action
  btnDownloadZip?.addEventListener('click', async () => {
    const strippedFiles = filesQueue.filter(f => f.strippedBlob !== null);
    if (strippedFiles.length === 0) return;

    const zip = new JSZip();
    strippedFiles.forEach((item, index) => {
      if (item.strippedBlob) {
        const ext = item.type === 'image/png' ? 'png' : 'jpg';
        zip.file(`clean_${index + 1}_${item.name.replace(/\.[^/.]+$/, "")}.${ext}`, item.strippedBlob);
      }
    });

    const zipBlob = await zip.generateAsync({ type: 'blob' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(zipBlob);
    link.download = `cleared_metadata_${Date.now()}.zip`;
    link.click();
  });

  // Update Summary Bar Status
  function updateQueueSummary() {
    fileCountBadge.textContent = filesQueue.length.toString();
    const strippedCount = filesQueue.filter(f => f.status === 'stripped').length;

    if (strippedCount > 0) {
      btnDownloadZip.disabled = false;
      btnDownloadZip.className = 'px-5 py-2.5 rounded-full bg-[#0070f3] text-white hover:bg-[#0761d1] text-sm font-medium transition-all shadow-sm flex items-center justify-center gap-2 cursor-pointer';
      queueStatusSummary.textContent = `${strippedCount} of ${filesQueue.length} files stripped & clean.`;
    } else {
      btnDownloadZip.disabled = true;
      btnDownloadZip.className = 'px-5 py-2.5 rounded-full bg-[var(--color-canvas-soft-2)] text-[var(--color-mute)] border border-[var(--color-hairline)] text-sm font-medium transition-all flex items-center justify-center gap-2 cursor-not-allowed';
      queueStatusSummary.textContent = filesQueue.length > 0 ? `${filesQueue.length} files ready for stripping.` : 'Ready to strip metadata.';
    }
  }

  // Open Tag Inspector Modal
  function openInspectorModal(fileId: string) {
    const item = filesQueue.find(f => f.id === fileId);
    if (!item) return;

    activeModalFileId = fileId;
    modalFilename.textContent = item.name;
    modalTagCount.textContent = `${item.rawTagCount} metadata tags extracted`;
    modalSearchInput.value = '';

    if (item.rawTags.latitude && item.rawTags.longitude) {
      modalGpsCallout.classList.remove('hidden');
      gpsCoordsText.textContent = `GPS Location: Lat ${item.rawTags.latitude.toFixed(4)}, Lon ${item.rawTags.longitude.toFixed(4)}`;
      gpsMapLink.href = `https://maps.google.com/?q=${item.rawTags.latitude},${item.rawTags.longitude}`;
    } else {
      modalGpsCallout.classList.add('hidden');
    }

    renderModalTagsTable(item.rawTags, '');
    inspectorModal.classList.remove('hidden');
  }

  // Filter Modal Table
  modalSearchInput?.addEventListener('input', () => {
    if (!activeModalFileId) return;
    const item = filesQueue.find(f => f.id === activeModalFileId);
    if (item) {
      renderModalTagsTable(item.rawTags, modalSearchInput.value.toLowerCase().trim());
    }
  });

  function renderModalTagsTable(tags: Record<string, any>, query: string) {
    modalTagsTbody.innerHTML = '';
    const entries = Object.entries(tags);
    let matchCount = 0;

    for (const [key, val] of entries) {
      const stringVal = typeof val === 'object' ? JSON.stringify(val) : String(val);
      
      if (query === '' || key.toLowerCase().includes(query) || stringVal.toLowerCase().includes(query)) {
        matchCount++;
        const tr = document.createElement('tr');
        tr.className = 'border-b border-[var(--color-hairline)] hover:bg-[var(--color-canvas-soft-2)] transition-colors';
        tr.innerHTML = `
          <td class="py-2 px-3 font-mono font-medium text-[var(--color-ink)]">${key}</td>
          <td class="py-2 px-3 font-mono text-[var(--color-body)] break-all max-w-xs">${stringVal}</td>
        `;
        modalTagsTbody.appendChild(tr);
      }
    }

    if (matchCount === 0) {
      modalEmptyState.classList.remove('hidden');
    } else {
      modalEmptyState.classList.add('hidden');
    }
  }

  function closeModal() {
    inspectorModal.classList.add('hidden');
    activeModalFileId = null;
  }

  modalCloseBtn?.addEventListener('click', closeModal);
  modalDismissBtn?.addEventListener('click', closeModal);
  inspectorModal?.addEventListener('click', (e) => {
    if (e.target === inspectorModal) closeModal();
  });
</script>
