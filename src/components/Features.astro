---
// Features.astro - Comprehensive Metadata Stripping Breakdown
---

<section id="features" class="w-full py-16 md:py-24 px-4 md:px-8 bg-[var(--color-canvas-soft)] border-t border-b border-[var(--color-hairline)] transition-colors">
  <div class="max-w-5xl mx-auto">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center mb-16">
      <span class="caption-mono text-[#0070f3] mb-2 font-mono">Everything We Clean</span>
      <h2 class="display-lg text-[var(--color-ink)] max-w-xl">
        Complete Metadata & Privacy Protection.
      </h2>
      <p class="text-sm md:text-base text-[var(--color-body)] max-w-lg mt-3">
        Every embedded data layer that can trace photos back to your device, location, or editing workflow is automatically eliminated.
      </p>
    </div>

    <!-- 3-up Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Card 1: GPS Geotags -->
      <div class="vercel-card p-6 flex flex-col justify-between bg-[var(--color-canvas)] border border-[var(--color-hairline)]">
        <div>
          <div class="w-10 h-10 rounded-lg bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] flex items-center justify-center text-[#ee0000] mb-4 shadow-xs">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>

          <h3 class="text-base font-semibold text-[var(--color-ink)] mb-2">GPS Location & Geotags</h3>
          <p class="text-xs text-[var(--color-body)] leading-relaxed mb-4">
            Smartphones and cameras embed precise latitude, longitude, and altitude coordinates into every shot, revealing your home address or location.
          </p>
        </div>

        <div class="pt-3 border-t border-[var(--color-hairline)] flex items-center justify-between text-[11px] font-mono text-[var(--color-mute)]">
          <span>Stripped Field</span>
          <span class="text-[#ee0000] dark:text-[#ff8080] bg-[#f7d4d6] dark:bg-[#ee0000]/20 border border-[#ee0000]/30 px-1.5 py-0.5 rounded font-semibold">GPSInfo / Exif</span>
        </div>
      </div>

      <!-- Card 2: Camera EXIF -->
      <div class="vercel-card p-6 flex flex-col justify-between bg-[var(--color-canvas)] border border-[var(--color-hairline)]">
        <div>
          <div class="w-10 h-10 rounded-lg bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] flex items-center justify-center text-[#0070f3] mb-4 shadow-xs">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>

          <h3 class="text-base font-semibold text-[var(--color-ink)] mb-2">Camera Hardware EXIF</h3>
          <p class="text-xs text-[var(--color-body)] leading-relaxed mb-4">
            Camera make, model, lens parameters, aperture, ISO, shutter speed, capture date, and unique device serial numbers are permanently stripped.
          </p>
        </div>

        <div class="pt-3 border-t border-[var(--color-hairline)] flex items-center justify-between text-[11px] font-mono text-[var(--color-mute)]">
          <span>Stripped Field</span>
          <span class="text-[#0070f3] dark:text-[#70b5ff] bg-[#d3e5ff] dark:bg-[#0070f3]/20 border border-[#0070f3]/30 px-1.5 py-0.5 rounded font-semibold">EXIF / TIFF</span>
        </div>
      </div>

      <!-- Card 3: AI Generation Prompts -->
      <div class="vercel-card p-6 flex flex-col justify-between bg-[var(--color-canvas)] border border-[var(--color-hairline)]">
        <div>
          <div class="w-10 h-10 rounded-lg bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] flex items-center justify-center text-[#7928ca] dark:text-[#b87fff] mb-4 shadow-xs">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L5.6 15.157a2 2 0 00-1.022.547l-1.42 1.42a2 2 0 000 2.828l1.42 1.42a2 2 0 002.828 0l1.42-1.42a2 2 0 00.547-1.022l.477-2.387a6 6 0 00-.517-3.86l-.158-.318a6 6 0 01-.517-3.86L5.157 5.6a2 2 0 00-.547-1.022L3.19 3.157a2 2 0 00-2.828 0l-1.42 1.42a2 2 0 000 2.828l1.42 1.42"/>
            </svg>
          </div>

          <h3 class="text-base font-semibold text-[var(--color-ink)] mb-2">AI Prompts & Seeds</h3>
          <p class="text-xs text-[var(--color-body)] leading-relaxed mb-4">
            Stable Diffusion parameters (Automatic1111/ComfyUI prompts, CFG scale, seed), Midjourney signatures, and DALL-E metadata headers are removed.
          </p>
        </div>

        <div class="pt-3 border-t border-[var(--color-hairline)] flex items-center justify-between text-[11px] font-mono text-[var(--color-mute)]">
          <span>Stripped Field</span>
          <span class="text-[#7928ca] dark:text-[#d8ccf1] bg-[#d8ccf1] dark:bg-[#7928ca]/20 border border-[#7928ca]/30 px-1.5 py-0.5 rounded font-semibold">tEXt / zTXt / PNG</span>
        </div>
      </div>

      <!-- Card 4: C2PA Content Credentials -->
      <div class="vercel-card p-6 flex flex-col justify-between bg-[var(--color-canvas)] border border-[var(--color-hairline)]">
        <div>
          <div class="w-10 h-10 rounded-lg bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] flex items-center justify-center text-[#29bc9b] mb-4 shadow-xs">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>

          <h3 class="text-base font-semibold text-[var(--color-ink)] mb-2">C2PA Content Credentials</h3>
          <p class="text-xs text-[var(--color-body)] leading-relaxed mb-4">
            Provenance data attached by Adobe Photoshop, Lightroom, and Content Authenticity Initiative tools detailing editing history and source assets.
          </p>
        </div>

        <div class="pt-3 border-t border-[var(--color-hairline)] flex items-center justify-between text-[11px] font-mono text-[var(--color-mute)]">
          <span>Stripped Field</span>
          <span class="text-[#29bc9b] dark:text-[#aaffec] bg-[#aaffec] dark:bg-[#29bc9b]/20 border border-[#29bc9b]/30 px-1.5 py-0.5 rounded font-semibold">C2PA Manifest</span>
        </div>
      </div>

      <!-- Card 5: XMP & IPTC Copyright -->
      <div class="vercel-card p-6 flex flex-col justify-between bg-[var(--color-canvas)] border border-[var(--color-hairline)]">
        <div>
          <div class="w-10 h-10 rounded-lg bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] flex items-center justify-center text-[#f5a623] mb-4 shadow-xs">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
            </svg>
          </div>

          <h3 class="text-base font-semibold text-[var(--color-ink)] mb-2">XMP & IPTC Annotations</h3>
          <p class="text-xs text-[var(--color-body)] leading-relaxed mb-4">
            Embedded author credits, captions, keywords, application version tags, and creation dates stored by photo editing software.
          </p>
        </div>

        <div class="pt-3 border-t border-[var(--color-hairline)] flex items-center justify-between text-[11px] font-mono text-[var(--color-mute)]">
          <span>Stripped Field</span>
          <span class="text-[#ab570a] dark:text-[#ffefcf] bg-[#ffefcf] dark:bg-[#ab570a]/20 border border-[#f5a623]/30 px-1.5 py-0.5 rounded font-semibold">XMP / IPTC</span>
        </div>
      </div>

      <!-- Card 6: Perceptual Fingerprint Reset -->
      <div class="vercel-card p-6 flex flex-col justify-between bg-[var(--color-canvas)] border border-[var(--color-hairline)]">
        <div>
          <div class="w-10 h-10 rounded-lg bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] flex items-center justify-center text-[var(--color-ink)] mb-4 shadow-xs">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457-.39-2.823-1.07-4"/>
            </svg>
          </div>

          <h3 class="text-base font-semibold text-[var(--color-ink)] mb-2">Image Hash & Fingerprint Reset</h3>
          <p class="text-xs text-[var(--color-body)] leading-relaxed mb-4">
            Sub-perceptual LSB pixel noise alteration resets perceptual image hashes, breaking cross-site image tracking and scraping match algorithms.
          </p>
        </div>

        <div class="pt-3 border-t border-[var(--color-hairline)] flex items-center justify-between text-[11px] font-mono text-[var(--color-mute)]">
          <span>Privacy Feature</span>
          <span class="text-[var(--color-ink)] bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] px-1.5 py-0.5 rounded font-semibold">Hash Perturbation</span>
        </div>
      </div>

    </div>

  </div>
</section>
