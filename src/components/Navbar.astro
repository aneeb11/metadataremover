---
// Navbar Component with Theme Switcher & Multi-Page Navigation
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { name: 'Tool', href: '/' },
  { name: 'Features', href: '/features' },
  { name: 'How It Works', href: '/how-it-works' },
  { name: 'Compare', href: '/comparison' },
  { name: 'FAQ', href: '/faq' },
  { name: 'Contact', href: '/contact' },
];
---

<header class="sticky top-0 z-50 w-full h-[64px] bg-[var(--color-canvas)]/90 backdrop-blur-md border-b border-[var(--color-hairline)] px-4 md:px-8 flex items-center justify-between">
  
  <!-- Brand Logo — uses same SVG path as favicon.svg -->
  <a href="/" class="flex items-center gap-3 group" aria-label="Meta Data Remover Home">
    <div class="w-8 h-8 flex items-center justify-center flex-shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 128 128" class="w-full h-full" aria-hidden="true">
        <path
          d="M50.4 78.5a75.1 75.1 0 0 0-28.5 6.9l24.2-65.7c.7-2 1.9-3.2 3.4-3.2h29c1.5 0 2.7 1.2 3.4 3.2l24.2 65.7s-11.6-7-28.5-7L67 45.5c-.4-1.7-1.6-2.8-2.9-2.8-1.3 0-2.5 1.1-2.9 2.7L50.4 78.5Zm-1.1 28.2Zm-4.2-20.2c-2 6.6-.6 15.8 4.2 20.2a17.5 17.5 0 0 1 .2-.7 5.5 5.5 0 0 1 5.7-4.5c2.8.1 4.3 1.5 4.7 4.7.2 1.1.2 2.3.2 3.5v.4c0 2.7.7 5.2 2.2 7.4a13 13 0 0 0 5.7 4.9v-.3l-.2-.3c-1.8-5.6-.5-9.5 4.4-12.8l1.5-1a73 73 0 0 0 3.2-2.2 16 16 0 0 0 6.8-11.4c.3-2 .1-4-.6-6l-.8.6-1.6 1a37 37 0 0 1-22.4 2.7c-5-.7-9.7-2-13.2-6.2Z"
          class="fill-[#171717] dark:fill-white"
        />
      </svg>
    </div>
    <div class="flex flex-col">
      <div class="flex items-center gap-1.5">
        <span class="font-semibold text-base tracking-tight text-[var(--color-ink)] leading-none">Meta Data Remover</span>
        <span class="caption-mono bg-[var(--color-canvas-soft-2)] text-[var(--color-ink)] text-[10px] px-1.5 py-0.5 rounded font-mono border border-[var(--color-hairline)]">TECH</span>
      </div>
      <span class="text-[11px] text-[var(--color-mute)] font-normal tracking-tight">metadataremover.tech</span>
    </div>
  </a>

  <!-- Center Nav Links (Desktop) -->
  <nav class="hidden md:flex items-center gap-1 text-sm text-[var(--color-body)]">
    {navLinks.map((link) => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      return (
        <a
          href={link.href}
          class={`px-3 py-1.5 rounded-full font-medium text-xs md:text-sm ${
            isActive
              ? 'bg-[var(--color-canvas-soft-2)] text-[var(--color-ink)] font-semibold border border-[var(--color-hairline)]'
              : 'text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft)]'
          }`}
        >
          {link.name}
        </a>
      );
    })}
  </nav>

  <!-- Right Actions -->
  <div class="flex items-center gap-2 md:gap-3">

    <!-- Theme Toggle — single button, icon swapped via JS -->
    <button
      id="theme-toggle"
      aria-label="Toggle theme"
      class="w-9 h-9 rounded-full bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] text-[var(--color-ink)] flex items-center justify-center hover:border-[var(--color-hairline-strong)] cursor-pointer shadow-xs"
    >
      <!-- Single icon path — JS sets the correct d attribute -->
      <svg id="theme-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path id="theme-icon-path" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
      </svg>
    </button>

    <!-- Client-Side Indicator Badge -->
    <div class="hidden lg:flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] text-xs font-medium text-[var(--color-ink)]">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#50e3c2] opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-[#29bc9b]"></span>
      </span>
      <span>100% In-Browser</span>
    </div>

    <!-- Quick Action CTA -->
    <a href="/" class="hidden sm:inline-flex items-center justify-center px-4 py-1.5 rounded-full bg-[var(--color-primary)] text-[var(--color-on-primary)] text-xs font-semibold hover:opacity-90 shadow-xs">
      Clean Image
    </a>

    <!-- Mobile Hamburger -->
    <button
      id="mobile-menu-toggle"
      aria-label="Toggle mobile menu"
      class="md:hidden w-9 h-9 rounded-lg bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] text-[var(--color-ink)] flex items-center justify-center"
    >
      <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Nav Drawer -->
<div id="mobile-menu" class="hidden md:hidden bg-[var(--color-canvas)] border-b border-[var(--color-hairline)] px-4 py-3 space-y-1.5">
  {navLinks.map((link) => (
    <a
      href={link.href}
      class={`block px-3 py-2 rounded-lg text-sm font-medium ${
        currentPath === link.href
          ? 'bg-[var(--color-canvas-soft-2)] text-[var(--color-ink)] font-semibold'
          : 'text-[var(--color-body)] hover:text-[var(--color-ink)]'
      }`}
    >
      {link.name}
    </a>
  ))}
  <button
    id="mobile-theme-toggle"
    class="w-full mt-1 flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium text-[var(--color-ink)] bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] cursor-pointer"
  >
    <span>Toggle Theme</span>
    <span id="mobile-theme-label" class="text-xs font-mono text-[var(--color-mute)]">Light</span>
  </button>
</div>

<script is:inline>
  // Icon paths
  const MOON_PATH = "M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z";
  const SUN_PATH  = "M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z";

  function applyIcon(isDark) {
    const path = document.getElementById('theme-icon-path');
    const mobileLabel = document.getElementById('mobile-theme-label');
    if (path) path.setAttribute('d', isDark ? SUN_PATH : MOON_PATH);
    if (mobileLabel) mobileLabel.textContent = isDark ? 'Dark' : 'Light';
  }

  function toggleTheme() {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    applyIcon(isDark);
  }

  // Set correct icon immediately on load (no flash)
  applyIcon(document.documentElement.classList.contains('dark'));

  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  document.getElementById('mobile-theme-toggle')?.addEventListener('click', toggleTheme);

  document.getElementById('mobile-menu-toggle')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
</script>
