---
// contact.astro - Contact Us & Feedback Page
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Metadata Remover — Support & Feedback | metadataremover.tech"
  description="Contact the Metadata Remover team for support, bug reports, or feature requests. Reach us at support@metadataremover.tech or use our feedback form."
  keywords="metadata remover contact, metadata remover support, metadata remover feedback, metadataremover.tech contact"
>
  <div class="w-full py-12 md:py-16 px-4 md:px-8 mesh-gradient-bg border-b border-[var(--color-hairline)] text-center">
    <div class="max-w-4xl mx-auto">
      <span class="caption-mono text-[#0070f3] mb-2 font-mono">Get In Touch</span>
      <h1 class="display-lg text-[var(--color-ink)] mb-4">Contact & Support</h1>
      <p class="text-sm md:text-base text-[var(--color-body)] max-w-xl mx-auto">
        Have suggestions for new image format parsers, bug reports, or feedback? Send us a message.
      </p>
    </div>
  </div>

  <section class="w-full py-16 px-4 md:px-8 bg-[var(--color-canvas)]">
    <div class="max-w-2xl mx-auto">
      
      <!-- Contact Card -->
      <div class="vercel-card p-6 md:p-8 space-y-6">
        
        <div class="flex items-center justify-between pb-4 border-b border-[var(--color-hairline)]">
          <div>
            <h2 class="text-base font-semibold text-[var(--color-ink)]">Send Us a Message</h2>
            <p class="text-xs text-[var(--color-mute)]">We usually respond within 24-48 hours</p>
          </div>
          <span class="font-mono text-xs text-[#0070f3]">support@metadataremover.tech</span>
        </div>

        <form id="contact-form" class="space-y-4">
          
          <div>
            <label class="block text-xs font-semibold text-[var(--color-ink)] mb-1">Your Name</label>
            <input 
              type="text" 
              required
              placeholder="e.g. Alex Morgan"
              class="w-full bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] rounded-lg px-3 py-2 text-xs text-[var(--color-ink)] focus:outline-none focus:border-[var(--color-ink)]"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-[var(--color-ink)] mb-1">Email Address</label>
            <input 
              type="email" 
              required
              placeholder="alex@example.com"
              class="w-full bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] rounded-lg px-3 py-2 text-xs text-[var(--color-ink)] focus:outline-none focus:border-[var(--color-ink)]"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-[var(--color-ink)] mb-1">Topic / Category</label>
            <select class="w-full bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] rounded-lg px-3 py-2 text-xs text-[var(--color-ink)] focus:outline-none focus:border-[var(--color-ink)]">
              <option value="feature">Feature Request / New Format Support</option>
              <option value="bug">Bug Report / Parser Issue</option>
              <option value="privacy">Privacy Question</option>
              <option value="general">General Inquiry</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-[var(--color-ink)] mb-1">Message</label>
            <textarea 
              rows="4" 
              required
              placeholder="Describe your question or feedback in detail..."
              class="w-full bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] rounded-lg px-3 py-2 text-xs text-[var(--color-ink)] focus:outline-none focus:border-[var(--color-ink)]"
            ></textarea>
          </div>

          <button 
            type="submit" 
            id="form-submit-btn"
            class="w-full py-2.5 rounded-full bg-[var(--color-primary)] text-[var(--color-on-primary)] text-xs font-semibold hover:opacity-90 transition-all shadow-xs"
          >
            Send Message
          </button>
        </form>

        <div id="contact-success-alert" class="hidden p-4 rounded-lg bg-[#aaffec] dark:bg-[#29bc9b]/20 border border-[#29bc9b] text-xs text-[#29bc9b] dark:text-[#aaffec] font-semibold text-center">
          Thank you! Your message has been sent successfully.
        </div>

      </div>

    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const alert = document.getElementById('contact-success-alert') as HTMLElement;

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      alert?.classList.remove('hidden');
      form.reset();
    });
  </script>
</Layout>
