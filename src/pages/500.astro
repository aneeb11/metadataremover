---
// 500.astro - 500 Internal Server Error Page
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="500: Server Error - Meta Data Remover"
  description="An unexpected error occurred. Reload Meta Data Remover to restore your 100% in-browser privacy sandbox."
>
  <div class="py-12 md:py-20 px-4 md:px-8 my-auto w-full flex flex-col items-center justify-center text-center">
    
    <div class="max-w-xl mx-auto flex flex-col items-center">
      <!-- Error Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-xs font-mono text-[#f5a623] mb-4 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-[#f5a623] animate-ping"></span>
        <span class="font-bold">ERROR 500</span>
        <span class="text-[var(--color-hairline-strong)]">•</span>
        <span class="text-[var(--color-body)]">Internal Error</span>
      </div>

      <!-- Error Monospace Status -->
      <h1 class="display-xl text-[var(--color-ink)] mb-2 tracking-tighter">
        500.
      </h1>

      <h2 class="display-md text-[var(--color-ink)] mb-3">
        Execution Error Occurred.
      </h2>

      <p class="text-sm text-[var(--color-body)] max-w-md mb-6 leading-relaxed">
        An unexpected internal error occurred. Reloading the page will reset the browser sandbox RAM and restore the metadata engine.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 w-full">
        <button 
          onclick="window.location.reload()" 
          class="px-6 py-2.5 rounded-full bg-[var(--color-primary)] text-[var(--color-on-primary)] text-xs md:text-sm font-semibold hover:opacity-90 transition-all shadow-xs cursor-pointer"
        >
          Reload Page ↻
        </button>

        <a 
          href="/" 
          class="px-6 py-2.5 rounded-full bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-[var(--color-ink)] text-xs md:text-sm font-semibold hover:border-[var(--color-hairline-strong)] transition-all"
        >
          Return to Home →
        </a>
      </div>
    </div>

  </div>
</Layout>
