---
// terms.astro - Terms of Service Page
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Terms of Service — Metadata Remover (metadataremover.tech)"
  description="Terms of Service for using the free online metadata remover at metadataremover.tech. Review permitted use, content rights, and disclaimer of warranties."
  keywords="metadata remover terms, metadata remover legal, free metadata remover terms of service"
>
  <div class="w-full py-12 md:py-16 px-4 md:px-8 mesh-gradient-bg border-b border-[var(--color-hairline)] text-center">
    <div class="max-w-4xl mx-auto">
      <span class="caption-mono text-[#0070f3] mb-2 font-mono">Service Terms</span>
      <h1 class="display-lg text-[var(--color-ink)] mb-4">Terms of Service</h1>
      <p class="text-sm md:text-base text-[var(--color-body)] max-w-xl mx-auto">
        Last updated: August 17, 2026. Please review these terms of use.
      </p>
    </div>
  </div>

  <section class="w-full py-16 px-4 md:px-8 bg-[var(--color-canvas)]">
    <div class="max-w-3xl mx-auto space-y-8 text-sm text-[var(--color-body)] leading-relaxed">
      
      <div class="space-y-3">
        <h2 class="text-base font-semibold text-[var(--color-ink)]">1. Acceptance of Terms</h2>
        <p>
          By accessing and using <strong>Meta Data Remover</strong> at <code>metadataremover.tech</code>, you accept and agree to be bound by these Terms of Service. If you do not agree to these terms, please do not use the application.
        </p>
      </div>

      <div class="space-y-3">
        <h2 class="text-base font-semibold text-[var(--color-ink)]">2. Description of Utility</h2>
        <p>
          Meta Data Remover is a browser-based utility designed to inspect, display, and strip embedded metadata fields (EXIF, IPTC, XMP, GPS, C2PA, AI generation tags) from user-selected image files locally in client RAM.
        </p>
      </div>

      <div class="space-y-3">
        <h2 class="text-base font-semibold text-[var(--color-ink)]">3. User Responsibility & Content Rights</h2>
        <p>
          You retain full ownership and intellectual property rights over all images processed using our utility. You are solely responsible for ensuring that you have the necessary legal rights to modify and strip metadata from files you upload to the browser sandbox.
        </p>
      </div>

      <div class="space-y-3">
        <h2 class="text-base font-semibold text-[var(--color-ink)]">4. Disclaimer of Warranties</h2>
        <p>
          The service is provided on an "AS IS" and "AS AVAILABLE" basis without warranties of any kind. While our software removes embedded file headers, it cannot remove visual pixel elements (such as visible text, logos, or visible watermarks) or third-party platform pixel classifiers.
        </p>
      </div>

      <div class="space-y-3">
        <h2 class="text-base font-semibold text-[var(--color-ink)]">5. Contact Information</h2>
        <p>
          For any questions regarding these Terms, please contact us at <code>terms@metadataremover.tech</code> or via our <a href="/contact" class="text-[#0070f3] underline">Contact Form</a>.
        </p>
      </div>

    </div>
  </section>
</Layout>
